{
  "name": "microservicio-pedidos-facturacion",
  "version": "1.0.0",
  "description": "Microservicio REST de gestión de pedidos y facturación",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init-db": "node src/config/init-db.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "echo \"(linter no configurado)\""
  },
  "keywords": ["microservicio", "rest", "api", "express", "sqlite"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/init-db.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "text-summary", "html", "lcov"],
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
